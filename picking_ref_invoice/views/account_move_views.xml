<odoo>
  <record id="view_move_form_inherit_bl_column" model="ir.ui.view">
    <field name="name">account.move.form.inherit.bl.column</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <!-- Ajoute une colonne à la liste des lignes de facture -->
      <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="before">
        <field name="picking_names" readonly="1" string="Bon de livraison"/>
      </xpath>
    </field>
  </record>
</odoo>
